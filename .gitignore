# PostiPerfetti — file locali e generati da non versionare

# Ambiente Python e cache
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Backup e residui di editing/patch
*.bak
*.bak-*
*.orig
*.rej
*~
*.swp

# Dati locali dell'utente
/classi/*
!/classi/Classe-BASE_esempio.txt
!/classi/Classe-COMPLETO_esempio.txt
/stato/*
/log/*

# Esportazioni generate nella radice del programma
/*.xlsx
/*.txt

# IDE / sistema operativo
.idea/
.vscode/
.DS_Store
.directory
.SynologyWorkingDirectory/

# Artefatti di build e packaging Windows
/.venv-build-windows/
/build/
/dist/
/dist-installer/
