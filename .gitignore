# «PostiPerfetti» — file locali e generati da non versionare

# Ambiente Python e cache
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Backup e residui di editing/patch
*.bak
*.bak-*
*.orig
*.rej
*~
*.swp

# Dati locali dell'utente
/classi/*
!/classi/Classe-BASE_esempio.txt
!/classi/Classe-COMPLETO_esempio.txt
/stato/*
/log/*

# Esportazioni e report generati dall'utente nella radice del programma.
# La regola /*.txt evita che report e statistiche locali finiscano per errore
# in un commit.
/*.xlsx
/*.txt
!/requirements.txt

# IDE / sistema operativo
.idea/
.vscode/
.DS_Store
.directory
.SynologyWorkingDirectory/

# Artefatti di build e packaging
/.venv-build-windows/
/build/
/dist/
/dist-installer/
/dist-linux/
/dist-release/
